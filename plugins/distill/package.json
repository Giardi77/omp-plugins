{
  "name": "omp-distill-extension",
  "version": "0.3.0",
  "type": "module",
  "description": "OMP extension that turns captured sessions into reviewed project knowledge.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Giardi77/omp-plugins.git",
    "directory": "plugins/distill"
  },
  "homepage": "https://github.com/Giardi77/omp-plugins/tree/main/plugins/distill",
  "keywords": [
    "omp",
    "oh-my-pi",
    "extension",
    "lessons",
    "skills"
  ],
  "omp": {
    "extensions": [
      "./src/index.ts"
    ],
    "features": {
      "read": {
        "description": "Read omp's session store and evaluate a session's traces.",
        "default": true
      },
      "learn": {
        "description": "Review proposed lessons and write approved ones into the project's skills and agent prompts.",
        "default": true
      }
    }
  },
  "scripts": {
    "test": "bun test",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@oh-my-pi/pi-coding-agent": "18.3.0",
    "@oh-my-pi/pi-tui": "18.3.0",
    "@oh-my-pi/pi-utils": "18.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
